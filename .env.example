# Hypothron AI — local SaaS configuration
# Copy to root .env and fill blanks locally. Never commit .env.
# scripts/run-api.sh safely loads root .env through uvicorn/python-dotenv.
# Alembic needs DATABASE_URL exported separately; do not source .env as shell code.
# Production uses private API/migration env files; see docs/SAAS_DEPLOYMENT.md.

# Required: PostgreSQL connection URI, not an API key.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in credentials. Hosted DB: require TLS
# using your provider's connection options (for example ?sslmode=require).
DATABASE_URL=

# Existing supported local origins; keep these until hosted origin work passes.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Inference retains ephemeral request-scoped BYOK. A stored environment key is
# not a shared inference credential; the application does not activate it.
# Model defaults/configuration are server-side and never expose this key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_DISCOVERY_TTL_SECONDS=300

# Reserved for future signed/encrypted session schemes. Current account sessions
# use independent opaque tokens stored as hashes, with no signing key required.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=

# Google OAuth Web application credentials. Live login requires browser consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/auth/google/callback

# Reserved: email verification/password recovery delivery is not implemented.
# Leave blank until selecting an existing SMTP service. No service provisioned.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional: consent-gated private encrypted S3-compatible investigation bundles.
# Disabled by default. Leave blanks if you do not have a storage account.
# Requires private bucket public-access-block checks and SSE AES256 support.
# Leave disabled until actual storage and pending-upload reconciliation are tested.
CLOUD_STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
