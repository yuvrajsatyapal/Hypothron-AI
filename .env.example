# Hypothron AI — SaaS configuration preparation
# Copy to root .env and fill blanks locally. Never commit .env.
# CURRENT code reads DATABASE_URL, APP_ORIGIN and NEXT_PUBLIC_API_ORIGIN only.
# Other settings below are RESERVED for the next implementation, not wired yet.
# Root .env is not automatically loaded by the current API launcher/Alembic
# or apps/web. Environment loading will be integrated in the next task.

# Required: PostgreSQL connection URI, not an API key.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Percent-encode special characters in credentials. Hosted DB: require TLS
# using your provider's connection options (for example ?sslmode=require).
DATABASE_URL=

# Existing supported local origins; keep these until hosted origin work passes.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000

# Required for planned server-side OpenRouter integration. Backend-only.
# Current inference still uses request-scoped BYOK; these do not enable it.
# Use an exact model ID available to your account; no Gemini key is required.
# Filling a key does NOT authorize paid calls. Live-call budgets need approval.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Required for planned account sessions. Backend-only random secret.
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=

# Required for planned Google OAuth. Configure a Web application OAuth client.
# This callback path is reserved and will be implemented/verified next.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/v1/auth/google/callback

# Optional: email verification/password recovery delivery (not wired yet).
# Leave blank until selecting an existing SMTP service. No service provisioned.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional: consent-gated private S3-compatible dataset storage (not wired yet).
# Disabled by default. Leave blanks if you do not have a storage account.
# No raw dataset upload is currently supported; a consent/security ADR is needed.
CLOUD_STORAGE_ENABLED=false
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
