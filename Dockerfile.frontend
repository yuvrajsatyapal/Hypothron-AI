FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS build
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/executor/package.json ./apps/executor/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
COPY apps/executor ./apps/executor
COPY packages ./packages
COPY scripts ./scripts
ARG HYPOTHRON_DEPLOYMENT=1
ARG APP_ORIGIN
ARG API_ORIGIN
ARG EXECUTOR_ORIGIN
ENV HYPOTHRON_DEPLOYMENT=$HYPOTHRON_DEPLOYMENT APP_ORIGIN=$APP_ORIGIN API_ORIGIN=$API_ORIGIN EXECUTOR_ORIGIN=$EXECUTOR_ORIGIN
RUN node scripts/bootstrap-assets.mjs && pnpm build
FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS web
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --chown=node:node apps/web/public ./apps/web/public
USER node
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
FROM node:22.22.3-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS executor
WORKDIR /app
ENV HOST=0.0.0.0 PORT=3001 NODE_ENV=production
COPY --from=build --chown=node:node /app/apps/executor/public ./apps/executor/public
COPY --chown=node:node apps/executor/server.mjs ./apps/executor/server.mjs
COPY --chown=node:node scripts/deployment/origins.mjs ./scripts/deployment/origins.mjs
USER node
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 CMD node -e "fetch('http://127.0.0.1:3001/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/executor/server.mjs"]
