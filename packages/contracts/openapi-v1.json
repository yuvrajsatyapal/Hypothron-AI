{
  "components": {
    "schemas": {
      "AdvanceRequest": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "key": {
            "format": "password",
            "maxLength": 512,
            "minLength": 8,
            "title": "Key",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "key"
        ],
        "title": "AdvanceRequest",
        "type": "object"
      },
      "Dataset": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 2,
            "title": "Columns",
            "type": "array"
          },
          "contract": {
            "$ref": "#/components/schemas/MetricPlan"
          },
          "datasetHash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Datasethash",
            "type": "string"
          }
        },
        "required": [
          "datasetHash",
          "columns",
          "contract"
        ],
        "title": "Dataset",
        "type": "object"
      },
      "EmptyRequest": {
        "additionalProperties": false,
        "properties": {},
        "title": "EmptyRequest",
        "type": "object"
      },
      "EvidenceInput": {
        "additionalProperties": false,
        "properties": {
          "datasetHash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Datasethash",
            "type": "string"
          },
          "jobId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Jobid",
            "type": "string"
          },
          "python": {
            "$ref": "#/components/schemas/Numeric"
          },
          "sql": {
            "$ref": "#/components/schemas/Numeric"
          }
        },
        "required": [
          "jobId",
          "datasetHash",
          "sql",
          "python"
        ],
        "title": "EvidenceInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MetricPlan": {
        "additionalProperties": false,
        "properties": {
          "amountColumn": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Amountcolumn",
            "type": "string"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          },
          "datasetHash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Datasethash",
            "type": "string"
          },
          "dateColumn": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "title": "Datecolumn",
            "type": "string"
          },
          "end": {
            "title": "End",
            "type": "string"
          },
          "kind": {
            "const": "revenue_sum",
            "title": "Kind",
            "type": "string"
          },
          "nullPolicy": {
            "enum": [
              "exclude",
              "error"
            ],
            "title": "Nullpolicy",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "timezone": {
            "const": "UTC",
            "title": "Timezone",
            "type": "string"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "kind",
          "datasetHash",
          "amountColumn",
          "dateColumn",
          "start",
          "end",
          "timezone",
          "currency",
          "nullPolicy"
        ],
        "title": "MetricPlan",
        "type": "object"
      },
      "Numeric": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Count",
            "type": "integer"
          },
          "minorUnits": {
            "anyOf": [
              {
                "pattern": "^(0|-?[1-9][0-9]{0,30})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minorunits"
          }
        },
        "required": [
          "minorUnits",
          "count"
        ],
        "title": "Numeric",
        "type": "object"
      },
      "RunInput": {
        "additionalProperties": false,
        "properties": {
          "datasets": {
            "items": {
              "$ref": "#/components/schemas/Dataset"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Datasets",
            "type": "array"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question",
          "datasets"
        ],
        "title": "RunInput",
        "type": "object"
      },
      "StartRequest": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "const": true,
            "title": "Consent",
            "type": "boolean"
          },
          "key": {
            "format": "password",
            "maxLength": 512,
            "minLength": 8,
            "title": "Key",
            "type": "string",
            "writeOnly": true
          },
          "model": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "title": "Model",
            "type": "string"
          },
          "provider": {
            "enum": [
              "gemini",
              "openrouter"
            ],
            "title": "Provider",
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/RunInput"
          },
          "requestId": {
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "request",
          "provider",
          "model",
          "key",
          "consent"
        ],
        "title": "StartRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Hypothron AI",
