# Non-secret Compose interpolation only. Do not put secrets here or in build arguments.
APP_ORIGIN=https://app.example.test
API_ORIGIN=https://api.example.test
EXECUTOR_ORIGIN=https://compute.example.net
API_ENV_FILE=/secure/hypothron/api.env
MIGRATION_ENV_FILE=/secure/hypothron/migration.env
DATABASE_PASSWORD_FILE=/secure/hypothron/database-password
# api.env (mode 0600), injected only to API/migration:
# DATABASE_URL=postgresql+psycopg://hypothron_app:URL_ENCODED_PASSWORD@database:5432/hypothron
# Authentication/object-storage variables are documented in docs/SAAS_DEPLOYMENT.md.
